PORT=8080
LOG_LEVEL=info
CHATBOT_URL=http://localhost:8081
# Placeholder curto de propósito (< 32 caracteres): copiar sem trocar falha na validação.
SESSION_SECRET=troque-este-segredo
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Número de proxies confiáveis à frente do gateway. 0 = não confiar em nenhum (X-Forwarded-For
# é ignorado). No Cloud Run use TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0
# Criação de sessão (POST /v1/session): limite por IP, mais estrito que o geral.
SESSION_CREATE_CAPACITY=5
SESSION_CREATE_PER_MINUTE=5
# Sessão criada e nunca usada (sem stream nem evento) expira mais cedo.
UNUSED_SESSION_TTL_SECONDS=1800
# Turnos por sessão executam um de cada vez; este é o máximo em execução + na fila.
MAX_QUEUED_TURNS=5
