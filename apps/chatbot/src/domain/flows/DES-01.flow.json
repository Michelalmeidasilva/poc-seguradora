{
  "version": "7.1",
  "routing_model": {
    "LIST": [
      "DETAILS"
    ],
    "DETAILS": [
      "CONTRACT"
    ],
    "CONTRACT": []
  },
  "screens": [
    {
      "id": "LIST",
      "title": "Conhecer produtos",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Escolha um serviço para conhecer os benefícios, planos e valores."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "service",
            "label": "Qual serviço quer conhecer?",
            "required": true,
            "data-source": [
              {
                "id": "0",
                "title": "Assistência Funeral",
                "description": "Suporte ao titular e aos dependentes, conforme as condições do serviço."
              },
              {
                "id": "1",
                "title": "Assistência Farmácia",
                "description": "Descontos em redes credenciadas, conforme as condições do serviço."
              },
              {
                "id": "2",
                "title": "Telemedicina",
                "description": "Atendimento remoto no ambiente do prestador, conforme disponibilidade."
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Ver detalhes",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "DETAILS"
              },
              "payload": {
                "service": "${form.service}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Detalhes do serviço",
      "data": {
        "service": {
          "type": "string",
          "__example__": "0"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Switch",
            "value": "${data.service}",
            "cases": {
              "0": [
                {
                  "type": "TextSubheading",
                  "text": "Assistência Funeral"
                },
                {
                  "type": "TextBody",
                  "text": "A Assistência Funeral oferece suporte ao titular e aos dependentes. A utilização depende das condições, limites e elegibilidade previstos no serviço contratado."
                }
              ],
              "1": [
                {
                  "type": "TextSubheading",
                  "text": "Assistência Farmácia"
                },
                {
                  "type": "TextBody",
                  "text": "A Assistência Farmácia oferece descontos em redes credenciadas. As redes participantes e as condições de uso devem ser confirmadas antes da utilização."
                }
              ],
              "2": [
                {
                  "type": "TextSubheading",
                  "text": "Telemedicina"
                },
                {
                  "type": "TextBody",
                  "text": "A Telemedicina acontece no ambiente do prestador, conforme disponibilidade, limites e condições do serviço contratado."
                }
              ]
            }
          },
          {
            "type": "TextSubheading",
            "text": "Planos e valores"
          },
          {
            "type": "TextSubheading",
            "text": "Individual"
          },
          {
            "type": "TextBody",
            "text": "R$ 29,90/mês"
          },
          {
            "type": "TextCaption",
            "text": "Somente titular."
          },
          {
            "type": "TextSubheading",
            "text": "Familiar"
          },
          {
            "type": "TextBody",
            "text": "R$ 39,90/mês"
          },
          {
            "type": "TextCaption",
            "text": "Titular e até 3 dependentes elegíveis neste exemplo."
          },
          {
            "type": "TextSubheading",
            "text": "Condições de uso"
          },
          {
            "type": "TextBody",
            "text": "Confira elegibilidade, limites, carências e disponibilidade nas condições de cada plano. Não há contratação nem pagamento nesta etapa."
          },
          {
            "type": "TextCaption",
            "text": "Preços e composição são fictícios, apresentados somente para demonstração. Assistência não é plano de saúde."
          },
          {
            "type": "Footer",
            "label": "Escolher plano",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "CONTRACT"
              },
              "payload": {
                "service": "${data.service}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONTRACT",
      "title": "Continuar contratação",
      "data": {
        "service": {
          "type": "string",
          "__example__": "0"
        }
      },
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Switch",
            "value": "${data.service}",
            "cases": {
              "0": [
                {
                  "type": "TextSubheading",
                  "text": "Assistência Funeral"
                }
              ],
              "1": [
                {
                  "type": "TextSubheading",
                  "text": "Assistência Farmácia"
                }
              ],
              "2": [
                {
                  "type": "TextSubheading",
                  "text": "Telemedicina"
                }
              ]
            }
          },
          {
            "type": "RadioButtonsGroup",
            "name": "modality",
            "label": "Escolha seu plano",
            "required": true,
            "data-source": [
              {
                "id": "individual",
                "title": "Individual",
                "description": "R$ 29,90/mês · somente titular"
              },
              {
                "id": "familiar",
                "title": "Familiar",
                "description": "R$ 39,90/mês · titular e dependentes elegíveis"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "cpf",
            "label": "CPF",
            "required": true,
            "input-type": "cpf",
            "min-chars": 11,
            "max-chars": 14,
            "helper-text": "Informe 11 dígitos, com ou sem pontuação.",
            "error-message": "Informe um CPF com 11 dígitos."
          },
          {
            "type": "TextCaption",
            "text": "Você continuará no chat com o serviço e o plano escolhidos para conferir os dados e concluir a contratação. Nenhuma cobrança é feita agora."
          },
          {
            "type": "Footer",
            "label": "Continuar contratação",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "intent": "contract",
                "service": "${data.service}",
                "modality": "${form.modality}",
                "cpf": "${form.cpf}"
              }
            }
          }
        ]
      }
    }
  ]
}
