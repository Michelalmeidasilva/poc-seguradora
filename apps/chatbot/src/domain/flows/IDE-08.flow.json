{
  "version": "7.1",
  "routing_model": {
    "FORM": [
      "REVIEW"
    ],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "FORM",
      "title": "Informar CPF",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Informe um CPF com 11 dígitos para abrir a demonstração."
          },
          {
            "type": "TextInput",
            "name": "cpf",
            "label": "CPF",
            "required": true,
            "sensitive": true,
            "input-type": "text"
          },
          {
            "type": "Footer",
            "label": "Validar formato",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "REVIEW"
              },
              "payload": {}
            }
          }
        ]
      },
      "sensitive": [
        "cpf"
      ]
    },
    {
      "id": "REVIEW",
      "title": "Revisar dados",
      "terminal": true,
      "success": true,
      "sensitive": [
        "cpf"
      ],
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revise os dados"
          },
          {
            "type": "TextBody",
            "text": "CPF: ••••"
          },
          {
            "type": "Footer",
            "label": "Enviar formulário",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "cpf": "${form.cpf}"
              }
            }
          }
        ]
      }
    }
  ]
}
