{
  "version": "7.1",
  "screens": [
    {
      "id": "FORM",
      "title": "Informar CPF",
      "terminal": true,
      "success": true,
      "sensitive": [
        "cpf"
      ],
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Informe um CPF com 11 dígitos para abrir a demonstração."
          },
          {
            "type": "TextInput",
            "name": "cpf",
            "label": "CPF",
            "required": true,
            "sensitive": true,
            "input-type": "text"
          },
          {
            "type": "Footer",
            "label": "Validar formato",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "cpf": "${form.cpf}"
              }
            }
          }
        ]
      }
    }
  ]
}
