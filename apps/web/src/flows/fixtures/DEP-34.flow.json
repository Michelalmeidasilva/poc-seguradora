{
  "version": "7.1",
  "routing_model": {
    "FORM": [
      "REVIEW"
    ],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "FORM",
      "title": "Dados complementares",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Qual é o celular do João e qual sexo biológico ele informa?"
          },
          {
            "type": "TextInput",
            "name": "phone",
            "label": "Celular do dependente",
            "required": true,
            "helper-text": "(00) 00000-0000",
            "input-type": "phone"
          },
          {
            "type": "Dropdown",
            "name": "biologicalSex",
            "label": "Sexo biológico informado",
            "required": true,
            "data-source": [
              {
                "id": "Feminino",
                "title": "Feminino"
              },
              {
                "id": "Masculino",
                "title": "Masculino"
              },
              {
                "id": "Prefiro não informar",
                "title": "Prefiro não informar"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Revisar inclusão",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "REVIEW"
              },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Revisar dados",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revise os dados"
          },
          {
            "type": "TextBody",
            "text": "Celular do dependente: ${form.phone}"
          },
          {
            "type": "TextBody",
            "text": "Sexo biológico informado: ${form.biologicalSex}"
          },
          {
            "type": "Footer",
            "label": "Enviar formulário",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "phone": "${form.phone}",
                "biologicalSex": "${form.biologicalSex}"
              }
            }
          }
        ]
      }
    }
  ]
}
