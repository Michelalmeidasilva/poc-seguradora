{
  "version": "7.1",
  "screens": [
    {
      "id": "REVIEW",
      "title": "Solicitar assistência",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Confira os dados essenciais antes do envio."
          },
          {
            "type": "TextInput",
            "name": "funeralCity",
            "label": "funeralCity",
            "visible": false
          },
          {
            "type": "TextInput",
            "name": "funeralState",
            "label": "funeralState",
            "visible": false
          },
          {
            "type": "TextSubheading",
            "text": "Dados do pedido"
          },
          {
            "type": "TextBody",
            "text": "Pessoa: Pessoa selecionada"
          },
          {
            "type": "TextBody",
            "text": "Cidade: ${form.funeralCity}"
          },
          {
            "type": "TextBody",
            "text": "Estado: ${form.funeralState}"
          },
          {
            "type": "TextBody",
            "text": "Benefício: Assistência funeral"
          },
          {
            "type": "EmbeddedLink",
            "text": "Corrigir",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "correction": true
              }
            }
          },
          {
            "type": "Footer",
            "label": "Enviar solicitação",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
