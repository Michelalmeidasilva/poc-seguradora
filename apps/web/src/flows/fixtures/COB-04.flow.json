{
  "version": "7.1",
  "screens": [
    {
      "id": "LIST",
      "title": "Regularizar parcela",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Neste cenário há um meio de regularização disponível. A disponibilidade real depende do produto e da processadora."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "choice",
            "label": "Regularizar parcela",
            "required": true,
            "data-source": [
              {
                "id": "0",
                "title": "Pagamento seguro",
                "description": "Autorização no ambiente da instituição"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Revisar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "choice": "${form.choice}"
              }
            }
          }
        ]
      }
    }
  ]
}
