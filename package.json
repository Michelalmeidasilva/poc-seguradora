{
  "name": "seguradora-services",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test && node --test scripts/workboard-check.test.mjs infra/smoke.test.mjs infra/check-runbook.test.mjs && bash infra/deploy.test.sh",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "build": "pnpm -r --if-present build",
    "check:workboard": "node scripts/workboard-check.mjs",
    "check:runbook": "node infra/check-runbook.mjs",
    "compose:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "compose:down": "docker compose -f infra/docker-compose.yml down -v",
    "smoke": "node infra/smoke.mjs",
    "test:infra": "bash infra/test-nginx.sh",
    "lint:workflows": "bash infra/lint-workflows.sh",
    "infra:deploy": "bash infra/deploy.sh",
    "test:deploy": "bash infra/deploy.test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
