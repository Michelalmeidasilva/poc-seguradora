# Configuração do deploy local (bash infra/deploy.sh). Copie para infra/.env (ignorado pelo git)
# e preencha. Sem segredos aqui: o SESSION_SECRET é gerado pelo Terraform no Secret Manager.
# Formato: CHAVE=valor, uma por linha; linhas com # são comentários; sem comentário na mesma
# linha do valor. O arquivo é lido, nunca executado. Chave desconhecida = erro (pega erro de
# digitação). Vazio = padrão indicado. Outro arquivo: --env-file <caminho>.

# Id do projeto GCP (obrigatório). O valor de exemplo é recusado.
PROJECT_ID=example-project-id
# Região do Cloud Run, Artifact Registry e sub-rede (padrão southamerica-east1).
REGION=southamerica-east1
# Bucket GCS do estado do Terraform (bootstrap, infra, status, smoke, destroy). Nome global,
# ex.: <PROJECT_ID>-tfstate. O bootstrap cria se faltar.
TF_STATE_BUCKET=example-project-id-tfstate
# Repositório Docker do Artifact Registry (padrão seguradora).
ARTIFACT_REGISTRY_REPO=seguradora

# LOG_LEVEL do gateway e do chatbot: fatal, error, warn, info, debug, trace, silent (padrão info).
LOG_LEVEL=info
# Proxies na frente do gateway: cliente -> GFE -> nginx do web -> GFE -> gateway = 3 (padrão 3).
TRUST_PROXY_HOPS=3
# URL pública do web com domínio próprio (https://host, sem barra final). Vazio = URL do Cloud Run.
WEB_CUSTOM_DOMAIN_URL=

# Orçamento opcional: conta de faturamento XXXXXX-XXXXXX-XXXXXX (vazio = sem orçamento),
# valor mensal em BRL (padrão 200) e e-mail extra de alerta (vazio = só os admins da conta).
BILLING_ACCOUNT_ID=
BUDGET_AMOUNT_BRL=
BUDGET_ALERT_EMAIL=

# Escala por serviço (vão juntos para a variável service_scaling do Terraform).
# MIN/MAX: inteiros, MAX >= 1 e >= MIN. MEMORY: <n>Mi ou <n>Gi.
# Padrões: MIN 0; MAX 2 no web e 1 nos demais; MEMORY 256Mi no web e 512Mi nos demais.
# gateway, chatbot e svc-* guardam estado em memória: MAX > 1 gera um AVISO (requisições de uma
# mesma sessão podem cair em instâncias diferentes).
WEB_MIN_INSTANCES=0
WEB_MAX_INSTANCES=2
WEB_MEMORY=256Mi
GATEWAY_MIN_INSTANCES=0
GATEWAY_MAX_INSTANCES=1
GATEWAY_MEMORY=512Mi
CHATBOT_MIN_INSTANCES=0
CHATBOT_MAX_INSTANCES=1
CHATBOT_MEMORY=512Mi
SVC_COTACAO_MIN_INSTANCES=0
SVC_COTACAO_MAX_INSTANCES=1
SVC_COTACAO_MEMORY=512Mi
SVC_APOLICE_MIN_INSTANCES=0
SVC_APOLICE_MAX_INSTANCES=1
SVC_APOLICE_MEMORY=512Mi
SVC_SINISTRO_MIN_INSTANCES=0
SVC_SINISTRO_MAX_INSTANCES=1
SVC_SINISTRO_MEMORY=512Mi
